# Required: Bearer token for MCP endpoint authentication
# Generate with: openssl rand -hex 32
REMINDERS_API_TOKEN=your-secret-token-here

# Server config (defaults shown)
HOST=127.0.0.1
PORT=8000

# Path to compiled Swift CLI binary (macOS only)
SWIFT_BRIDGE_PATH=./swift-bridge/.build/release/EventKitCLI

# Required: external hostname served by Cloudflare Tunnel.
# The MCP SDK validates Host headers to prevent DNS rebinding attacks.
# Without this, requests from Cloudflare Tunnel will be rejected with 421.
EXTERNAL_HOST=reminders.yourdomain.com
